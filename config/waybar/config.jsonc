{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 7,
  "margin-left": 150,
  "margin-right": 150,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["mpris", "custom/caffeine", "clock"],

  "modules-right": [
    "wireplumber",
    "backlight",
    "battery",
    "cpu",
    "memory",
    "temperature",
    "custom/notification",
    "custom/cpucat",
    "custom/skull",
    "custom/lock"
  ],

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },

  "mpris": {
    "format": " {artist} - {title} ",
    "format-paused": "󰐊 {artist} - {title} ",
    "max-length": 60,
    "tooltip": true,
    "player": "spotify"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 10
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󱐋",
    "format-plugged": "{capacity}% 󰂄",
    "format-full": "{capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "on-click": "/home/arch/scripts/clock-dropdown.sh",
    "tooltip": true,
    "tooltip-format": "Media + Wi-Fi 󰲛"
  },

  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f} GiB",
    "tooltip": true
  },

  "temperature": {
    "interval": 10,
    "format": " {temperatureC}°C",
    "tooltip": true
  },

  "custom/lock": {
    "format": " ",
    "on-click": "wlogout -b 4",
    "tooltip": true,
    "tooltip-format": "Power Menu"
  },

  "custom/notification": {
    "exec": "makoctl list -j | jq length",
    "on-click": "makoctl dismiss -a",
    "on-click-right": "makoctl mode -t dnd",
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂛"
    },
    "tooltip": false
  },

  "custom/caffeine": {
    "format": "{}",
    "return-type": "json",
    "exec": "/home/arch/scripts/caffeine.sh --status",
    "on-click": "/home/arch/scripts/caffeine.sh --toggle && pkill -RTMIN+8 -x waybar",
    "signal": 8,
    "tooltip": true
  },

  "custom/cpucat": {
    "exec": "/home/arch/scripts/catloop.sh",
    "spacing": 1,
    "format": "{}",
    "tooltip": true
  },

  "custom/skull": {
    "exec": "/home/arch/scripts/skull.sh",
    "spacing": 1,
    "format": "{}",
    "tooltip": true
  }
}
